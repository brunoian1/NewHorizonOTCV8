<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NewHorizonsLauncher</AssemblyName>
    <RootNamespace>NewHorizonsLauncher</RootNamespace>
    <Product>New Horizons Launcher</Product>
    <Title>New Horizons Launcher</Title>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\new-horizons-logo.png" LogicalName="NewHorizonsLogo.png" />
    <EmbeddedResource Include="Assets\background.png" LogicalName="NewHorizonsBackground.png" />
  </ItemGroup>
</Project>
